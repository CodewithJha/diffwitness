# Copy to .env locally if you want to override defaults. Never commit real keys.
# The hosted demo reads only the variables below; all are optional.

# HTTP listener
# PORT=3000
# HOST=0.0.0.0

# Hosted demo limits (see docs/reference/hosted-demo.md)
# DEMO_MAX_CONCURRENT=2
# DEMO_REQUEST_TIMEOUT_MS=30000
# DEMO_STAGE_TIMEOUT_MS=15000
# DEMO_WORKSPACE_TTL_MS=120000
# DEMO_MAX_OUTPUT_BYTES=262144
# DEMO_MAX_BODY_BYTES=1024
# DEMO_SHUTDOWN_GRACE_MS=10000

# Optional: live explanations from the CLI (`diffwitness explain --provider featherless`).
# Never used by the hosted demo (MockAI only) and never forwarded to its child processes.
# FEATHERLESS_API_KEY=
